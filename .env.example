# GEMINI_API_KEY: Opsional jika fitur AI digunakan.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL aplikasi saat berjalan atau ter-deploy.
APP_URL="http://localhost:3000"

# ============================================================================
# Konfigurasi Supabase (Ambil dari Supabase Dashboard -> Project Settings -> API Keys)
# ============================================================================
# Project URL (contoh: https://abcdefghijklmno.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_URL="https://your-project-id.supabase.co"

# Publishable / Anon Key (diawali 'sb_publishable_...' atau JWT role 'anon')
VITE_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"

# Secret / Service Role Key (WAJIB diawali 'sb_secret_...' atau JWT role 'service_role')
# Jangan pernah gunakan publishable/anon key di sini dan jangan kirim ke frontend.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-secret-or-service-role-key"

# Secret penanda sesi lokal (otomatis dibuat oleh scripts/setup-env.sh)
SESSION_SECRET="change-this-to-a-random-32-char-secret"
